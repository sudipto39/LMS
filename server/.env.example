NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Storage Configuration ──────────────────────────────────────────────────
# "local" for university server disk storage (zero cloud/AWS cost), "s3" for AWS S3
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# ── Nodemailer SMTP Email Configuration (Free Lifetime) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_SERVICE=gmail
EMAIL_FROM=GiteaForge LMS <no-reply@giteaforge.com>
RESEND_API_KEY=

# ── JWT Secrets: Generate securely with: openssl rand -base64 48 ───────────
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-characters-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-characters-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email verification (set true to require email confirmation on signup)
EMAIL_VERIFICATION=false

# Frontend URL (CORS origin — comma-separated allowed)
CLIENT_URL=http://localhost:5173

# Gitea self-hosted instance
GITEA_BASE_URL=http://localhost:3000/api/v1
GITEA_WEBHOOK_SECRET=your-gitea-webhook-secret-here
GITEA_ADMIN_TOKEN=your-gitea-admin-token-here

# Judge0 code execution engine
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# AWS S3 (optional, only required when STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here

# Redis (optional — falls back to DB if unavailable)
REDIS_URL=redis://localhost:6379

# ── Database Seeding Passwords (Optional) ──────────────────────────────────
# If left unset, scripts generate secure random passwords for demo accounts
SEED_DEFAULT_PASSWORD=
ADMIN_SEED_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_ADMIN_PASSWORD=
GITEA_DEFAULT_USER_PASSWORD=

# ── Maintenance & Diagnostics (Optional) ───────────────────────────────────
SERVER_HOST=localhost
OLD_GITEA_URL=
NEW_GITEA_URL=
