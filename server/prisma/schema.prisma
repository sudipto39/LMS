// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SUPERVISOR
  ADMIN
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  password         String
  role             Role      @default(STUDENT)
  isEmailVerified  Boolean   @default(false)
  giteaUsername    String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  supervisedProjects Project[]         @relation("ProjectSupervisor")
  ownedProjects      Project[]         @relation("ProjectOwner")
  activities         Activity[]
  enrollments        BatchEnrollment[]

  @@map("users")
}

model Batch {
  id          String   @id @default(cuid())
  name        String   @unique
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  enrollments BatchEnrollment[]
  projects    Project[]

  @@map("batches")
}

model BatchEnrollment {
  userId  String
  batchId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([userId, batchId])
  @@map("batch_enrollments")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches Batch[]

  @@map("courses")
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String?
  repoName     String?  @unique
  repoUrl      String?
  ownerId      String
  supervisorId String?
  batchId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner      User       @relation("ProjectOwner", fields: [ownerId], references: [id])
  supervisor User?      @relation("ProjectSupervisor", fields: [supervisorId], references: [id])
  batch      Batch      @relation(fields: [batchId], references: [id])
  milestones Milestone[]
  activities Activity[]

  @@map("projects")
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  projectId   String
  feedback    String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  userId    String?
  projectId String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("activities")
}