generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(cuid())
  name                String
  email               String            @unique
  password            String
  role                Role              @default(STUDENT)
  isEmailVerified     Boolean           @default(false)
  giteaUsername       String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  department          String?
  phoneNumber         String?
  universityId        String?           @unique
  refreshToken        String?
  activities          Activity[]
  enrollments         BatchEnrollment[]
  reviewedMilestones  Milestone[]       @relation("MilestoneReviewer")
  submittedMilestones Milestone[]       @relation("MilestoneSubmitter")
  ownedProjects       Project[]         @relation("ProjectOwner")
  supervisedProjects  Project[]         @relation("ProjectSupervisor")
  projectMembers      ProjectMember[]

  @@map("users")
}

model Batch {
  id          String            @id @default(cuid())
  name        String            @unique
  courseId    String
  createdAt   DateTime          @default(now())
  endYear     Int
  isActive    Boolean           @default(true)
  startYear   Int
  enrollments BatchEnrollment[]
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@map("batches")
}

model BatchEnrollment {
  userId  String
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, batchId])
  @@map("batch_enrollments")
}

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  code          String?  @unique
  durationYears Int      @default(4)
  isActive      Boolean  @default(true)
  school        String?
  batches       Batch[]

  @@map("courses")
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String?
  repoName     String?
  repoUrl      String?
  ownerId      String
  supervisorId String?
  batchId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  endDate      DateTime?
  feedback     String?
  isActive     Boolean       @default(true)
  startDate    DateTime?
  status       ProjectStatus @default(DRAFT)
  technologies String[]
  activities   Activity[]
  milestones   Milestone[]
  batch        Batch         @relation(fields: [batchId], references: [id])
  owner        User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  supervisor   User?         @relation("ProjectSupervisor", fields: [supervisorId], references: [id])
  parentProjectId String?
  parentProject   Project?      @relation("ProjectExtension", fields: [parentProjectId], references: [id])
  extensions      Project[]     @relation("ProjectExtension")
  phase           Int           @default(1)
  members         ProjectMember[]

  @@map("projects")
}

model Milestone {
  id            String          @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  projectId     String
  feedback      String?
  attachments   Json?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isActive      Boolean         @default(true)
  order         Int             @default(0)
  reviewedById  String?
  studentNotes  String?
  submittedById String?
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy    User?           @relation("MilestoneReviewer", fields: [reviewedById], references: [id])
  submittedBy   User?           @relation("MilestoneSubmitter", fields: [submittedById], references: [id])

  @@index([projectId, order])
  @@index([projectId, status])
  @@map("milestones")
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  userId    String?
  projectId String?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@map("activities")
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

enum Role {
  STUDENT
  SUPERVISOR
  ADMIN
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  IN_PROGRESS
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}
