{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "GiteaForge — Academic Project Management Backend",
  "homepage": "https://github.com/sudipto39/LMS#readme",
  "bugs": {
    "url": "https://github.com/sudipto39/LMS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudipto39/LMS.git"
  },
  "license": "ISC",
  "author": "sudipto gayen",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && npm run copy-prisma",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.cjs",
    "test:smoke": "node scripts/smoke-test.js",
    "test:stress": "node scripts/stress-test.js",
    "test:k6": "node scripts/run-k6.js",
    "lint": "eslint .",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx prisma/seedUsers.ts",
    "db:seed:gitea": "tsx prisma/seedGiteaUsers.ts",
    "db:seed:repos": "tsx prisma/seedGiteaRepos.ts",
    "copy-prisma": "node -e \"const{cpSync}=require('fs');cpSync('src/generated','dist/generated',{recursive:true});\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "dotenv": "^17.4.1",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "pg": "^8.20.0",
    "resend": "^6.9.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
