# ============================================
# GiteaForge Environment Configuration
# ============================================
# Copy this file to .env.local for local development
# Never commit real API keys or secrets!

# Backend API URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api

# WebSocket URL for real-time features (chat, notifications)
VITE_WS_URL=ws://localhost:5000

# Gitea Server URL (your self-hosted Gitea instance)
VITE_GITEA_URL=http://localhost:3000

# Application name (shown in UI)
VITE_APP_NAME=GiteaForge